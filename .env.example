# Server-only configuration. Never prefix secrets with NEXT_PUBLIC_.
APP_ORIGIN=https://tender-compliance-matrix.vercel.app
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...) or legacy service_role key; server only.
SUPABASE_SECRET_KEY=
# Copy actual invited user UUIDs from Supabase Auth. Single tenant: pegis.
ACCESS_MEMBERS=[]
# Generate at least 32 random bytes as hex; never commit the real value.
PROFILE_SIGNING_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Billing is enabled according to the owner; verify the key's exact project.
GEMINI_PAID_PROJECT_CONFIRMED=true
# Pegis approval is pending: BOTH of the following must stay disabled/empty.
AI_PROCESSING_ENABLED=false
AI_APPROVED_TENANTS=
# Exact HTTPS hostnames, comma-separated. Empty disables website fetching.
WEBSITE_ALLOWED_HOSTS=
